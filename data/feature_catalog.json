{
  "_comment": "Podium feature catalog used by gap detection (s3) and opportunity mapping (s4). Edit + restart the backend to apply. Rule shapes: 'always' (string sentinel for built-in features) OR { col: <xlsx column>, OP: <value> } where OP is one of ever_gt, gt, lt, equals, contains. underused_when is optional; features with no usage signal (paid_phones, phones_ai_voice) skip it. Prose for gaps/opportunities is generated by s5 narration — the catalog is pure rules.",

  "reviews": {
    "label": "Reviews",
    "goal_categories": ["reviews"],
    "owned_when": "always",
    "underused_when": { "col": "REVIEW INVITES LAST 30DAYS", "lt": 1 }
  },

  "messaging": {
    "label": "Messaging",
    "goal_categories": ["messaging", "lead_response"],
    "owned_when": "always",
    "underused_when": { "col": "RECEIVED MESSAGES LAST 30DAYS", "lt": 1 }
  },

  "webchat": {
    "label": "Webchat",
    "goal_categories": ["lead_response", "lead_integration"],
    "owned_when": { "col": "WEBCHAT LEADS RECEIVED LAST 30DAYS", "ever_gt": 0 },
    "underused_when": { "col": "WEBCHAT LEADS RECEIVED LAST 30DAYS", "lt": 10 }
  },

  "text_ai": {
    "label": "Text AI",
    "goal_categories": ["ai_adoption", "lead_response", "messaging", "reviews"],
    "owned_when": { "col": "AI PRODUCT NAMES", "contains": "Text AI" },
    "underused_when": { "col": "AI Conversations L28 Days", "lt": 1 }
  },

  "phones_ai_voice": {
    "label": "Phones AI (Voice)",
    "goal_categories": ["call_capture", "ai_adoption"],
    "owned_when": { "col": "AI PRODUCT NAMES", "contains": "Phones AI" }
  },

  "paid_phones": {
    "label": "Paid Phones",
    "goal_categories": ["call_capture", "lead_response"],
    "owned_when": { "col": "PHONES PRODUCT STATUS", "equals": "Paid Phones" }
  },

  "payments": {
    "label": "Payments",
    "goal_categories": ["payments"],
    "owned_when": { "col": "PROCESSED AMOUNT ALL TIME", "gt": 0 },
    "underused_when": { "col": "PROCESSED AMOUNT LAST 30 DAYS", "lt": 1 }
  },

  "campaigns": {
    "label": "Campaigns",
    "goal_categories": ["messaging", "lead_response"],
    "owned_when": { "col": "LOCATION CAMPAIGNS SUBSCRIBER LIMIT", "gt": 0 },
    "underused_when": { "col": "CAMPAIGN MESSAGES SENT LAST 30 DAYS", "lt": 1 }
  }
}
